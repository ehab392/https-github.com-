# ===== قاعدة البيانات (PostgreSQL) =====
# من Neon أو Supabase أو جهازك المحلي
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ===== الأمان =====
# نص عشوائي طويل (32 حرفًا فأكثر). لا تشاركه مع أحد
JWT_SECRET=غيّر-هذا-إلى-نص-عشوائي-طويل-جدًا

# ===== حساب الأدمن الافتراضي (يُنشأ تلقائيًا عند أول تشغيل) =====
ADMIN_EMAIL=admin@hujjat-batool.com
ADMIN_PASSWORD=غيّر-كلمة-المرور-هذه
ADMIN_NAME=مدير المتجر
ADMIN_PHONE=0500000000

# ===== رفع الصور (Cloudinary) =====
# انسخ الرابط من لوحة Cloudinary (API Environment variable)
# إن تركته فارغًا تُحفظ الصور في مجلد public/uploads (للتجربة المحلية فقط)
CLOUDINARY_URL=

# ===== إعدادات المتجر =====
# رقم واتساب بالصيغة الدولية بدون + أو أصفار (مثال: 966500000000)
WHATSAPP_NUMBER=
CURRENCY=ر.س

# ===== عام =====
PORT=3000
NODE_ENV=development
